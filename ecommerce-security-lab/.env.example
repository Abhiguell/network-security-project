# Copy this file to ".env" (the apps also create .env automatically on first start).
# NEVER commit .env or share it: it contains secrets.

# --- Midtrans SANDBOX keys (optional) ---
# Get them free: https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
# Without them, the store uses its built-in "Demo gateway" instead.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# --- Shared secret for the signed Lab -> Store simulation API ---
# Auto-generated on first start if empty. Both apps must use the SAME value.
SIM_API_SECRET=

# --- Optional ---
# SHOP_URL=http://127.0.0.1:5000        # where the lab finds the store (change for a 2-VM setup)
# SHOP_HOST=0.0.0.0                     # let other lab VMs reach the store (isolated network only!)
# LAB_HOST=0.0.0.0
# SHOP_SECRET_KEY= / LAB_SECRET_KEY=    # fixed session keys so logins survive restarts
